MONGO_URI=your_mongodb_connection_string
LOCAL_GAME_SESSION_SECRET=replace_with_a_long_random_secret

# Uključi pre planiranog održavanja da svi igrači vide YotB maintenance ekran.
# Server mora ostati pokrenut; posle održavanja vrati na false i redeploy/restartuj servis.
MAINTENANCE_MODE=false

# Local development option:
# FIREBASE_SERVICE_ACCOUNT_PATH=C:\absolute\path\to\firebase-service-account.json

# Hosting option:
# FIREBASE_SERVICE_ACCOUNT_BASE64=base64_encoded_service_account_json

# Uključiti tek kada je App Check verzija aplikacije distribuirana i metrika pokazuje
# da legitimni klijenti šalju važeće Play Integrity tokene.
FIREBASE_APP_CHECK_ENFORCE=false

# Account deletion remains disabled until separate QA and release approval.
ACCOUNT_DELETION_ENABLED=false
# Set true only after verifying one process/instance and non-overlapping deploys.
ACCOUNT_DELETION_SINGLE_INSTANCE=false
# Separately review the Analytics property permission/API and consent QA first.
ANALYTICS_PRIVACY_ENABLED=false
ANALYTICS_PROPERTY_ID=527510324

# AdMob rewarded ads server-side verification:
# Configure this callback URL in AdMob for rewarded ad unit 7896891915:
# https://your-domain.com/api/admob/reward-ssv
ADMOB_REWARDED_AD_UNIT_ID=ca-app-pub-4319963185096437/7896891915
# Production must stay fail-closed. Use false only for isolated local development.
REQUIRE_ADMOB_SSV=true
# Google-signed SSV is required for production rewards. Set true only as a temporary emergency override.
ALLOW_ADMOB_CLIENT_REWARD_FALLBACK=false
# Optional: how long reward claim waits for Google's SSV callback, and how old a callback may be.
# ADMOB_SSV_WAIT_TIMEOUT_MS=12000
# ADMOB_SSV_MAX_AGE_MS=600000
# ADMOB_CLIENT_FALLBACK_GRACE_MS=2000

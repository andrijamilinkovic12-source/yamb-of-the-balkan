# Kopirati u bezbedno lokalno okruženje ili podesiti kao secrets na staging hostu.
# Nikada ne unositi produkcioni Mongo URI ili produkcioni URL.
YAMB_RUNTIME_ENV=staging
YAMB_STAGING_INSTANCE_ID=reconnect-qa-01
YAMB_STAGING_DB_NAME=yamb_reconnect_qa
# Opcionalno: upisati stvarno ime produkcione baze ako je pouzdano utvrđeno.
# YAMB_PRODUCTION_DB_NAME=replace_with_verified_production_database_name
MONGO_URI=mongodb+srv://staging_user:replace_me@staging-cluster.example/yamb_reconnect_qa

# Javni HTTPS URL upravo ove staging serverske instance.
YAMB_CAPACITOR_SERVER_URL=https://yamb-reconnect-qa.example.com
YAMB_ANDROID_APPLICATION_ID=com.yamb.balkan.staging

# Obavezni zasebni staging secrets.
LOCAL_GAME_SESSION_SECRET=replace_with_a_unique_staging_secret
YAMB_MONITOR_TOKEN=replace_with_a_unique_staging_monitor_token
MONITOR_ACTIVITY_HASH_SECRET=replace_with_a_unique_staging_hash_secret

# Staging Firebase projekat i dva namenska test naloga.
# Project-ID-only Auth is sufficient for reconnect QA; push stays off by default.
YAMB_STAGING_FIREBASE_PROJECT_ID=yamb-reconnect-qa
YAMB_PRODUCTION_FIREBASE_PROJECT_ID=yamb-of-the-balkan
GOOGLE_CLOUD_PROJECT=yamb-reconnect-qa
FIREBASE_WEB_API_KEY=replace_with_staging_firebase_web_api_key
FIREBASE_APP_CHECK_ENFORCE=false

# Samo za lokalni Android staging build; mora biti apsolutna putanja.
YAMB_STAGING_GOOGLE_SERVICES_JSON=C:\absolute\path\to\staging-google-services.json

# Tokom reconnect QA ne testirati oglase ili nagrade.
REQUIRE_ADMOB_SSV=true
ALLOW_ADMOB_CLIENT_REWARD_FALLBACK=false
MAINTENANCE_MODE=false

# Separate account-deletion QA: project-ID-only Auth cannot manage/delete users.
# Provide a service account scoped only to Firebase Authentication in this QA project.
# FIREBASE_SERVICE_ACCOUNT_PATH=C:\absolute\path\to\qa-auth-service-account.json
ACCOUNT_DELETION_ENABLED=false
ACCOUNT_DELETION_SINGLE_INSTANCE=false
# QA must use a separate Analytics property; production 527510324 is rejected.
ANALYTICS_PRIVACY_ENABLED=false
ANALYTICS_PROPERTY_ID=
# Public SDK config of a Web app registered in the QA Auth project, never production.
# ACCOUNT_DELETION_FIREBASE_WEB_CONFIG_JSON={"apiKey":"QA_PUBLIC_API_KEY","authDomain":"yamb-reconnect-qa.firebaseapp.com","projectId":"yamb-reconnect-qa","appId":"QA_WEB_APP_ID"}

# Tournament QA only. Never enable these on the production service.
# Real FCM requires a service account from this QA project, with the FCM role.
# Keep credentials in the QA host's private environment, never in Git or chat.
YAMB_STAGING_FCM_ENABLED=false
YAMB_STAGING_FCM_ALLOWED_UIDS=[]
TOURNAMENT_READINESS_ENABLED=true
TOURNAMENT_ROLLOUT_APPROVED=false

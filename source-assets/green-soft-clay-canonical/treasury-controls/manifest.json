        { "id": "tab-effects", "role": "visual-effects catalog navigation", "master": "navigation-tabs/green-tab-effects-master-v1.png", "masterSha256": "5867b3d00b9917d7c4e9f7a58513acd5200951f914d012f1ba4bd585077124ef", "runtime": "www/assets/green-soft-clay/canonical/treasury-controls/tab-effects-v1.png", "size": 256, "runtimeSha256": "939931a4c6945357936f703318baaa0c894121a620a9cd86bf9f021f3e736d7e" },

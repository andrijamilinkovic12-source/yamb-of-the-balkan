  "semanticExclusions": [
    "individual achievement trophies",
    "Statistics aggregate trophies metric",
    "Treasury collection medals",
    "Tournament tabs and match or registration states",
    "Tournament winner, ceremony and finalist awards",
    "Quarterly League tabs, podium medals and rank badges",
    "Daily completed and already-played states",
    "Invite accepted state",
    "Solo claim action",
    "Rewarded Video active and unavailable states",
    "generic claim, check and playback actions",
    "CSS active state of a navigation tab",
    "dukats, consumable tokens and winner marks"
  ],
  "integration": {
    "treasuryTabs": "connected",
    "rulesNavigationGlyphs": "connected",
    "itemStatusHelper": "connected",
    "hiddenDescriptionLock": "connected",
    "insufficientFundsAlerts": "connected",
    "roomOnDemand": "connected",
    "legacyRuntime": "retired in standardization step 3",
    "finalAudit": "locked by www/themes/green/asset-registry.json and scripts/check-theme-performance.js"
  },
  "rules": [
    "Navigation tabs and item statuses remain separate subfamilies.",
    "Owned and active are distinct item states and must not share one icon.",
    "Locked requirements and insufficient balance are distinct failure states.",
    "Do not reuse Treasury item statuses for tournament, daily, invite, solo or rewarded-video states.",
    "Use the canonical runtime pack instead of copying or recoloring individual controls."
  ]
}
